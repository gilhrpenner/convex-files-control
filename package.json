{
  "name": "@gilhrpenner/convex-files-control",
  "description": "A convex files control component for Convex.",
  "repository": {
    "type": "git",
    "url": "https://github.com/gilhrpenner/convex-files-control"
  },
  "homepage": "https://github.com/gilhrpenner/convex-files-control#readme",
  "bugs": {
    "url": "https://github.com/gilhrpenner/convex-files-control/issues"
  },
  "version": "0.6.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "keywords": [
    "convex",
    "component",
    "files",
    "storage",
    "upload",
    "download",
    "access-control"
  ],
  "type": "module",
  "scripts": {
    "dev": "run-p -r 'dev:*'",
    "dev:backend": "convex dev --typecheck-components",
    "dev:frontend": "npm --prefix example run dev:frontend",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.ts' -i '**/*.test.ts' -c 'npm run build:codegen' --initial",
    "predev": "npm run build",
    "build": "tsc --project ./tsconfig.build.json",
    "build:codegen": "npx convex codegen --component-dir ./src/component && npm run build",
    "build:clean": "rm -rf dist *.tsbuildinfo && npm run build:codegen",
    "verify:dist-esm": "node ./scripts/check-dist-esm.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "npm run typecheck && npm --prefix example run typecheck",
    "lint": "eslint src/",
    "all": "run-p -r 'dev:*' 'test:watch'",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "prepublishOnly": "npm run build:clean && npm run verify:dist-esm",
    "release:check": "gh workflow run release.yml --ref main -f dry_run=true",
    "release": "gh workflow run release.yml --ref main -f dry_run=false",
    "check": "npm run build && npm run typecheck:all && npm run lint:all && npm test && npm run verify:dist-esm && npm --prefix example run build",
    "lint:all": "npm run lint && npm --prefix example run lint",
    "build:example": "npm run build && npm --prefix example run build",
    "demo:build": "npm run build && convex deploy --cmd-url-env-var-name VITE_CONVEX_URL --cmd \"npm --prefix example run build\"",
    "demo:deploy": "npm run demo:build && npm --prefix example exec -- wrangler pages deploy example/dist --project-name=convex-files-control-example --branch=main"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/__tests__/**"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@convex-dev/action-retrier": "^0.3.1",
    "convex-helpers": "^0.1.134"
  },
  "peerDependencies": {
    "convex": "^1.46.0",
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "5.1.0",
    "chokidar-cli": "3.0.0",
    "convex": "1.49.0",
    "convex-test": "0.0.67",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "npm-run-all2": "8.0.4",
    "prettier": "3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js",
  "engines": {
    "node": ">=22.12.0"
  }
}
